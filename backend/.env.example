# SentinelMesh AI Backend Environment Configuration
PROJECT_NAME="SentinelMesh AI"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8001

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# MongoDB Database Configuration
# Provide a MongoDB connection string to enable live MongoDB persistence (e.g. MongoDB Atlas)
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="sentinelmesh_db"

# Authentication & Security
# IMPORTANT: Provide a strong, cryptographically secure secret key in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="sentinelmesh_default_insecure_jwt_secret_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: Google AI Studio API Key for AI Agents
GEMINI_API_KEY=""
